{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pacto user-facing release notes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "items": {
      "type": "array",
      "anyOf": [{ "maxItems": 0 }, { "minItems": 3, "maxItems": 6 }],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "detail"],
        "properties": {
          "kind": { "enum": ["new", "improved", "fixed"] },
          "title": { "$ref": "#/definitions/title" },
          "detail": { "$ref": "#/definitions/detail" }
        }
      }
    }
  },
  "definitions": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "type": "string", "pattern": "\\S", "maxLength": 80 },
        "es": { "type": "string", "pattern": "\\S", "maxLength": 80 }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "type": "string", "pattern": "\\S", "maxLength": 240 },
        "es": { "type": "string", "pattern": "\\S", "maxLength": 240 }
      }
    }
  }
}
