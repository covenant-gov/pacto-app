# Copy to `.env` (gitignored). Debug Tauri loads this into the Rust process at startup.

# ALCHEMY_RPC_KEY=
# POCKET_RPC_KEY=

# VITE_WALLET_RPC_DOCS_URL=

# Optional fallback if no in-app Pimlico key is saved on Status
# PIMLICO_API_KEY=
# Optional override of the bundler URL (non-Alchemy EP v0.7); otherwise built from the Pimlico key
# BUNDLER_RPC_URL=
# Optional override; Sepolia default is networks.sepolia.erc4337.accountImplementation in pacto-protocol-addresses.json
# PACTO_ERC4337_ACCOUNT_IMPL=

# Comma-separated relay URL override for debug builds only; unset keeps production relays.
# A locally-issued wss:// endpoint also needs a build with `-f local-relay-tls`.
# PACTO_TRUSTED_RELAYS=
# Klipy GIF search (Rust-only egress: src-tauri/src/klipy.rs)
# KLIPY_API_KEY=
