# Copy to `.env` (gitignored). Debug Tauri loads this into the Rust process at startup.

# ALCHEMY_RPC_KEY=
# POCKET_RPC_KEY=

# VITE_WALLET_RPC_DOCS_URL=

# Sponsored gov writes: Pimlico EntryPoint v0.7 bundler (Sepolia → api.pimlico.io/v2/11155111/…)
# PIMLICO_API_KEY=
# Optional override of the bundler URL (non-Alchemy EP v0.7); otherwise built from PIMLICO_API_KEY
# BUNDLER_RPC_URL=
# Optional override; Sepolia default is networks.sepolia.erc4337.accountImplementation in pacto-protocol-addresses.json
# PACTO_ERC4337_ACCOUNT_IMPL=

# Comma-separated relay URL override for debug builds only; unset keeps production relays
# PACTO_TRUSTED_RELAYS=
