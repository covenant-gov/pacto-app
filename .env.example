# Copy to `.env` (gitignored). Debug Tauri loads this into the Rust process at startup.

# ALCHEMY_RPC_KEY=
# POCKET_RPC_KEY=

# VITE_WALLET_RPC_DOCS_URL=

# Required for sponsored gov writes (EntryPoint v0.7 bundler; not derived from ALCHEMY_RPC_KEY)
# BUNDLER_RPC_URL=
# Optional override; Sepolia default is networks.sepolia.erc4337.accountImplementation in pacto-protocol-addresses.json
# PACTO_ERC4337_ACCOUNT_IMPL=
