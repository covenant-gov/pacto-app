---
import { blogContent, logoContestPost } from '../content/blog';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="blog-banner" aria-label={blogContent.featuredLabel}>
  <div class="blog-banner-inner">
    <p class="blog-banner-copy">
      <span class="blog-banner-lead">{blogContent.bannerLead}</span>
      {' '}
      <span class="blog-banner-title">{logoContestPost.title}</span>
    </p>
    <a
      class="btn btn-blue"
      href={`${base}${logoContestPost.path}`}
    >
      {blogContent.bannerAction}
    </a>
  </div>
</section>
