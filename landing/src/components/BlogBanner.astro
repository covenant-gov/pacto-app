---
const articleTitle = 'Building the Network-State Substrate';
const articleHref = 'https://dpunk1.substack.com/p/building-the-network-state-substrate';
---

<section class="blog-banner" aria-label="Featured article">
  <div class="blog-banner-inner">
    <p class="blog-banner-copy">
      <span class="blog-banner-lead">Read on blog:</span>
      {' '}
      <span class="blog-banner-title">{articleTitle}</span>
    </p>
    <a
      class="btn btn-blue"
      href={articleHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      Read Blog
    </a>
  </div>
</section>
