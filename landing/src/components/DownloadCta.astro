---
---

<section class="download" id="download" aria-labelledby="download-title">
  <div class="section-inner">
    <p class="eyebrow">Download Pacto</p>
    <h2 class="section-title" id="download-title">Start using Pacto today</h2>
    <p class="section-body">
      Live now on macOS, Linux, and Windows. You can also grab the source and build it yourself.
    </p>
    <div class="download-actions">
      <a
        class="btn btn-green js-download-btn"
        href="https://github.com/covenant-gov/pacto-app/releases"
        data-label-style="download"
        id="downloadBtn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="js-download-label" id="downloadText">Download for your OS</span>
      </a>
      <p class="platform-note" id="platformNote">Available for Windows, macOS &amp; Linux</p>
      <div class="all-downloads">
        <button type="button" class="all-downloads-toggle" id="toggleDownloads">
          Show all Downloads
        </button>
        <div class="downloads-list" id="downloadsList"></div>
      </div>
    </div>
  </div>
</section>
