---
const docsHref = 'https://github.com/covenant-gov/pacto-app#readme';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="section-inner">
    <h1 class="hero-title" id="hero-title">Your community. Your rules. Your data.</h1>
    <p class="hero-sub">
      Pacto is private messaging plus real governance: built so nobody can read your messages,
      freeze your funds, or shut down your group.
    </p>
    <div class="hero-actions">
      <a
        class="btn btn-blue js-download-btn"
        href="#download"
        data-label-style="get"
        id="heroGetPacto"
      >
        <span class="js-download-label">Get Pacto</span>
      </a>
      <a
        class="btn btn-ghost-light"
        href={docsHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read the Docs
      </a>
    </div>
  </div>
</section>
