---
// Public download page shell. Runtime logic lives in the client script below.
---

<section class="download-page" aria-label="Download Pacto">
  <header class="hero">
    <img src="/pacto-app/logo.png" alt="Pacto logo" width="96" height="96" />
    <h1>Download Pacto</h1>
    <p class="tagline">Private, censorship-resistant community organizing.</p>
  </header>

  <div class="primary" id="primary-download">
    <div class="card primary-card">
      <p class="loading">Detecting your platform and loading release info…</p>
    </div>
  </div>

  <div class="all-downloads">
    <button type="button" id="toggle-all" aria-expanded="false">
      Show all downloads
    </button>
    <ul id="download-list" class="download-list hidden" aria-live="polite"></ul>
  </div>

  <footer class="fallback">
    <p>
      Looking for an older release or source code?
      <a href="https://github.com/covenant-gov/pacto-app/releases" target="_blank" rel="noopener noreferrer">View all releases on GitHub</a>.
    </p>
  </footer>
</section>

<script src="../scripts/platform.ts"></script>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    gap: 1.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .hero {
    text-align: center;
  }

  .hero h1 {
    margin: 1rem 0 0.25rem;
    font-size: 2rem;
  }

  .tagline {
    color: var(--muted);
    margin: 0;
  }

  .primary {
    width: 100%;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .card .meta {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .card .tag {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .loading {
    color: var(--muted);
    margin: 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .button:hover {
    background: var(--accent-hover);
  }

  .button.secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .button.secondary:hover {
    background: var(--card);
  }

  .all-downloads {
    width: 100%;
  }

  #toggle-all {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    cursor: pointer;
    width: 100%;
  }

  #toggle-all:hover {
    background: var(--card);
  }

  #toggle-all:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .download-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .download-list.hidden {
    display: none;
  }

  .download-list li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .download-list .info {
    display: flex;
    flex-direction: column;
  }

  .download-list .label {
    font-weight: 600;
  }

  .download-list .meta {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .download-list .actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .fallback {
    color: var(--muted);
    text-align: center;
    font-size: 0.875rem;
  }

  .fallback a {
    color: var(--accent);
  }

  .error-card {
    border-color: #ef4444;
  }

  .error-card .meta {
    color: #ef4444;
  }
</style>
