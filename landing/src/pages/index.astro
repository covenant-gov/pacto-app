---
import DownloadPage from '../components/DownloadPage.astro';

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Download Pacto — a private, censorship-resistant community organizing platform." />
    <title>Pacto — Download</title>
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
  </head>
  <body>
    <main>
      <DownloadPage />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0c0f;
    --text: #e8e8e8;
    --muted: #9aa0a6;
    --accent: #3b82f6;
    --accent-hover: #2563eb;
    --card: #15171c;
    --border: #2a2d35;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    color-scheme: dark;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>
