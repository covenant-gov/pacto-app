---
interface Props {
  title: string;
  description: string;
  /** Path under the site base, e.g. `` or `wargame/`. */
  path?: string;
  current: 'download' | 'wargame';
}

const {
  title,
  description,
  path = '',
  current,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const origin = 'https://covenant-gov.github.io';
const canonical = new URL(path, `${origin}${base}`).href;
const ogImage = new URL('assets/og-image.jpg', `${origin}${base}`).href;
const homeHref = base;
const wargameHref = `${base}wargame/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Pacto, private messenger, encrypted messaging, end-to-end encryption, decentralized, privacy, secure messaging, open source, no metadata, no KYC, no ads, free messaging, wargame, governance" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pacto" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pacto logo on a dark purple gradient with the tagline Private. Encrypted. Yours." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pacto_app" />
    <meta name="twitter:creator" content="@pacto_app" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Pacto logo on a dark purple gradient with the tagline Private. Encrypted. Yours." />
    <meta name="theme-color" content="#7c4cff" />
    <title>{title}</title>
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}assets/favicon/apple-icon-180x180.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}assets/favicon/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}assets/favicon/favicon-96x96.png`} />
    <link rel="shortcut icon" href={`${base}assets/favicon/favicon.ico`} />
    <link rel="manifest" href={`${base}assets/favicon/manifest.json`} />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Site">
        <a class="site-nav-brand" href={homeHref}>pacto</a>
        <ul class="site-nav-tabs">
          <li>
            <a href={homeHref} aria-current={current === 'download' ? 'page' : undefined}>Download</a>
          </li>
          <li>
            <a href={wargameHref} aria-current={current === 'wargame' ? 'page' : undefined}>Wargame</a>
          </li>
        </ul>
      </nav>
    </header>
    <slot />
  </body>
</html>
